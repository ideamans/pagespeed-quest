{
  "name": "pagespeed-quest",
  "version": "0.13.0",
  "type": "module",
  "description": "A framework for efficient web front-end speed improvement",
  "main": "build/index.js",
  "typings": "build/index.d.ts",
  "module": "build/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideamans/pagespeed-quest.git"
  },
  "license": "GPL-3.0-or-later",
  "keywords": [
    "HTTP Proxy",
    "Performance",
    "Lighthouse"
  ],
  "bin": {
    "psq": "build/command.js"
  },
  "scripts": {
    "build": "run-s build:module build:llmdocs",
    "build:module": "tsc -p tsconfig.json",
    "build:llmdocs": "node scripts/build-llm-docs.js",
    "validate-plugin-skills": "node scripts/validate-plugin-skills.js",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"src/**/*.ts\" --write",
    "fix:lint": "eslint src --fix",
    "test": "run-s build:module test:*",
    "test:lint": "eslint src",
    "test:prettier": "prettier \"src/**/*.ts\" --list-different",
    "test:spelling": "cspell \"{README.md,.github/*.md,src/**/*.ts}\"",
    "test:unit": "nyc --silent ava",
    "test:plugins": "node scripts/validate-plugin-skills.js",
    "test:llmdocs": "node scripts/build-llm-docs.js --check",
    "check-cli": "run-s test diff-integration-tests check-integration-tests",
    "check-integration-tests": "run-s check-integration-test:*",
    "diff-integration-tests": "mkdir -p diff && rm -rf diff/test && cp -r test diff/test && rm -rf diff/test/test-*/.git && cd diff && git init --quiet && git add -A && git commit --quiet --no-verify --allow-empty -m 'WIP' && echo '\\n\\nCommitted most recent integration test output in the \"diff\" directory. Review the changes with \"cd diff && git diff HEAD\" or your preferred git diff viewer.'",
    "watch:build": "tsc -p tsconfig.json -w",
    "watch:test": "nyc --silent ava --watch",
    "cov": "run-s build test:unit cov:html cov:lcov && open-cli coverage/index.html",
    "cov:html": "nyc report --reporter=html",
    "cov:lcov": "nyc report --reporter=lcov",
    "cov:check": "nyc report && nyc check-coverage --lines 100 --functions 100 --branches 100",
    "reset-hard": "git clean -dfx && git reset --hard && yarn",
    "adhoc": "yarn build && node build/adhoc.js",
    "command": "yarn build && node build/command.js",
    "prepublishOnly": "yarn build",
    "postinstall": "node scripts/postinstall.js",
    "ai:regen": "run-s build:module build:llmdocs validate-plugin-skills"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "commander": "^15",
    "execa": "^10",
    "iconv-lite": "^0.7",
    "jschardet": "^4",
    "lighthouse": "^13.6",
    "node-watch": "^0.7.4",
    "pino": "^10",
    "pino-pretty": "^13",
    "prettier": "^3",
    "puppeteer": "^25",
    "rust-http-playback-proxy": "0.11.1",
    "tmp-promise": "^3.0.3"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.1",
    "@types/node": "^22",
    "ava": "^8",
    "axios": "^1.21.0",
    "cspell": "^10",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "npm-run-all2": "^9.0.4",
    "nyc": "^18",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "files": [
    "build",
    "scripts",
    "llmdocs",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "ava": {
    "failFast": true,
    "timeout": "60s",
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "src/": "build/"
      }
    },
    "environmentVariables": {
      "LOG_LEVEL": "error"
    },
    "files": [
      "!build/**"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "printWidth": 120
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "exclude": [
      "**/*.spec.js"
    ]
  }
}
